APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=true
# Set a long random value before adding sessions or authentication.
SECRET_KEY=replace-with-a-long-random-value
CORS_ALLOWED_ORIGINS=
MAX_CHAT_MESSAGE_LENGTH=10000
MAX_SESSION_ID_LENGTH=128
MAX_CONTENT_LENGTH=65536

# Optional FakeStore read-only product catalog; it has no inventory quantity API.
FAKESTORE_ENABLED=false
FAKESTORE_API_BASE_URL=https://fakestoreapi.com
FAKESTORE_TIMEOUT_SECONDS=4

# The inference bundle and intent descriptions are included in this project.
# Optional overrides may be project-relative paths; the packaged paths work by default.
# XLMR_MODEL_PATH=models/xlmr_intent_classifier
# XLMR_LABEL_MAPPING_PATH=models/xlmr_intent_classifier/label_mapping.json
# XLMR_INTENT_DESCRIPTIONS_PATH=app/classifier/intent_descriptions.json
INTENT_CONFIDENCE_THRESHOLD=95.0
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# Optional PostgreSQL connection for database foundation/migrations.
# Leave empty for classifier/graph work without a local database. Uncomment and
# replace the placeholders in your ignored .env to enable PostgreSQL access.
DATABASE_URL=

# Choose 'postgres' only after configuring DATABASE_URL and applying migrations.
BUSINESS_DATA_BACKEND=json
# Local development format: postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/ecom_support_dev
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10

# LangGraph conversation checkpoint storage. Memory is the development default.
CHECKPOINT_BACKEND=memory
# Use postgres only after configuring DATABASE_URL and PostgreSQL connectivity.

# Optional document RAG (Phase 5.2). Leave keys blank until configured.
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
DEEPSEEK_MODEL=deepseek-flash
RAG_TOP_K=4
RAG_MIN_SCORE=0.35
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
# Approved and fictional demo content are stored and indexed separately.
RAG_KNOWLEDGE_DIR=knowledge_base/approved
RAG_DEMO_KNOWLEDGE_DIR=knowledge_base/demo
PINECONE_NAMESPACE=ecom-support-kb-approved-v1
PINECONE_DEMO_NAMESPACE=ecom-support-kb-demo-v1
RAG_USE_DEMO_KNOWLEDGE=false
